{
  "rules": [
    {"name": "Properties review", "path": "**/*.properties", "rule": "rule_docs/properties.md"},
    {"name": "Mapper and DAO XML review", "path": "**/*{mapper,dao}*.xml", "rule": "rule_docs/mapper_dao_xml.md"},
    {"name": "Maven POM review", "path": "**/pom.xml", "rule": "rule_docs/pom_xml.md"},
    {"name": "Gradle build review", "path": "**/build.gradle", "rule": "rule_docs/build_gradle.md"},
    {"name": "package.json review", "path": "**/package.json", "rule": "rule_docs/package_json.md"},
    {"name": "Cargo manifest review", "path": "**/Cargo.toml", "rule": "rule_docs/cargo_toml.md"},
    {"name": "JSON review", "path": "**/*.{json,json5}", "rule": "rule_docs/json.md"},
    {"name": "GitHub Actions review", "path": ".github/workflows/**/*.{yaml,yml}", "rule": "rule_docs/github_workflows.md"},
    {"name": "GitHub configuration review", "path": ".github/**/*.{yaml,yml}", "rule": "rule_docs/github_config.md"},
    {"name": "YAML review", "path": "**/*.{yaml,yml}", "rule": "rule_docs/yaml.md"},
    {"name": "Go review", "path": "**/*.go", "rule": "rule_docs/go.md"},
    {"name": "Java review", "path": "**/*.java", "rule": "rule_docs/java.md"},
    {"name": "ArkTS review", "path": "**/*.ets", "rule": "rule_docs/arkts.md"},
    {"name": "TypeScript and JavaScript review", "path": "**/*.{ts,js,tsx,jsx}", "rule": "rule_docs/ts_js_tsx_jsx.md"},
    {"name": "Kotlin review", "path": "**/*.kt", "rule": "rule_docs/kotlin.md"},
    {"name": "Rust review", "path": "**/*.rs", "rule": "rule_docs/rust.md"},
    {"name": "C++ review", "path": "**/*.{cpp,cc,hpp}", "rule": "rule_docs/cpp.md"},
    {"name": "C review", "path": "**/*.c", "rule": "rule_docs/c.md"},
    {"name": "General review", "path": "**", "rule": "rule_docs/default.md"}
  ]
}
