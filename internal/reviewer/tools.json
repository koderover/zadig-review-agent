  {
    "name": "code_search",
    "description": "Search tracked repository files. By default search_text is fixed-string text: an unescaped | separates OR alternatives, \\| searches a literal pipe, and redundant regex escapes such as \\( or \\. are normalized to their literal characters. file_patterns are Git pathspecs; use_perl_regexp enables PCRE instead.",
    "parameters": {
      "type": "object",
      "properties": {
        "search_text": {"type": "string"},
        "file_patterns": {"type": "array", "items": {"type": "string"}},
        "case_sensitive": {"type": "boolean"},
        "use_perl_regexp": {"type": "boolean"}
      },
      "required": ["search_text"]
    }
  },
  {
    "name": "changed_diff_read",
    "description": "Read the supplied diffs for one or more other changed files. Prefer this over repository searches when another changed file may confirm or reject a hypothesis. Valid paths are still returned when a batch also contains rejected paths. Do not request the current file because its diff is already in the review prompt.",
    "parameters": {
      "type": "object",
      "properties": {
        "file_paths": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "maxItems": 10
        }
      },
      "required": ["file_paths"]
    }
  },
  {
    "name": "file_find",
    "description": "Find repository files by matching a keyword against file basenames. This is not a glob search.",
    "parameters": {
      "type": "object",
      "properties": {
        "query_name": {"type": "string"},
        "case_sensitive": {"type": "boolean"}
      },
      "required": ["query_name"]
    }
  },
  {
    "name": "code_comment",
    "description": "Record one or more concrete findings for changed code in the current file. Prefer findings to batch every confirmed issue into one call. Supply exactly one of finding or findings. If file is supplied, it must equal the current reviewed file; findings for context files are rejected.",
    "parameters": {
      "type": "object",
      "properties": {
        "finding": {
          "type": "object",
          "properties": {
            "severity": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
            "category": {"type": "string", "enum": ["correctness", "security", "concurrency", "performance", "compatibility", "tests"]},
            "rule_id": {"type": "string"},
            "file": {"type": "string"},
            "start_line": {"type": "integer"},
            "end_line": {"type": "integer"},
            "existing_code": {"type": "string"},
            "title": {"type": "string"},
            "problem": {"type": "string"},
            "evidence": {"type": "string"},
            "suggestion": {"type": "string"},
            "confidence": {"type": "number", "minimum": 0, "maximum": 1}
          },
          "required": ["severity", "category", "title", "problem", "evidence", "suggestion", "confidence"]
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
