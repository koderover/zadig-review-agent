{
  "include": [
    "src/**/*.go"
  ],
  "exclude": [
    "**/*.lock",
    "**/vendor/**",
    "**/generated/**"
  ],
  "rules": [
    {
      "name": "Go code review",
      "path": "**/*.go",
      "rule": ".zadig-review/docs/go-review.md",
      "merge_system_rule": true
    },
    {
      "name": "Go formatting",
      "path": "**/*.go",
      "rule": "Check that changed Go code follows gofmt formatting."
    }
  ]
}
